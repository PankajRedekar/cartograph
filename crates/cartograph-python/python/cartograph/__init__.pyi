class CodeGraph:
    def __init__(
        self,
        path: str | Path | None = ...,
        profile: str = ...,
        in_memory: bool = ...,
    ) -> None: ...
    @classmethod
    def open(
        cls,
        path: str | Path | None = ...,
        profile: str = ...,
        in_memory: bool = ...,
    ) -> CodeGraph: ...
    def __enter__(self) -> CodeGraph: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...
    def close(self) -> None: ...
    @property
    def is_open(self) -> bool: ...
    @property
    def profile(self) -> str: ...
    def index(
        self,
        force: bool = ...,
        staged: bool = ...,
        branch: str | None = ...,
        threads: int | None = ...,
    ) -> IndexStats: ...
    def status(self) -> GraphStats: ...
    def locate(
        self,
        query: str,
        code: bool = ...,
        limit: int = ...,
    ) -> LocateResult: ...
    def impact(
        self,
        target: str,
        branch: str | None = ...,
        staged: bool = ...,
        depth: int = ...,
    ) -> ImpactResult: ...
    def test_selector(
        self,
        target: str,
        branch: str | None = ...,
    ) -> TestSelectorResult: ...
    def routes(
        self,
        filter_query: str | None = ...,
    ) -> list[RouteTrace]: ...
    def lint_arch(
        self,
        strict: bool = ...,
    ) -> LintArchReport: ...
    def complexity(
        self,
        top: int = ...,
        danger_zone: bool = ...,
    ) -> ComplexityReport: ...
    def deadcode(
        self,
        min_lines: int = ...,
    ) -> DeadCodeReport: ...
    def extract_logic(
        self,
        query: str | None = ...,
        symbol: str | None = ...,
        concept: str | None = ...,
        deep: bool = ...,
    ) -> LogicReport: ...
    def diagnose(
        self,
        trace_or_log: str,
        file_path: str | None = ...,
        deep: bool = ...,
        offline: bool = ...,
    ) -> DiagnosisReport: ...
    def diagram(
        self,
        symbol_or_concept: str | None = ...,
        diagram_type: str = ...,
        format: str = ...,
        depth: int = ...,
        direction: str = ...,
        max_nodes: int = ...,
        collapse_modules: bool = ...,
        theme: str = ...,
    ) -> DiagramResult: ...
    def to_networkx(self) -> nx.DiGraph: ...
    def to_igraph(self) -> ig.Graph: ...
    def nodes_df(self, engine: Literal["polars", "pandas"] = ...) -> Any: ...
    def edges_df(self, engine: Literal["polars", "pandas"] = ...) -> Any: ...
    def complexity_df(self, engine: Literal["polars", "pandas"] = ...) -> Any: ...
    def to_polars(self) -> dict[str, pl.DataFrame]: ...
    def to_pandas(self) -> dict[str, pd.DataFrame]: ...

